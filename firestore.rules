rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per project: { count: number }. Anyone can read; writes must
    // only touch the count field with a non-negative integer.
    match /hearts/{projectId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
      allow delete: if false;
    }

    // One doc per comment: { projectId, name, text, createdAt }. Anyone can
    // read and create; comments are immutable once posted (no edit/delete UI).
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['projectId', 'name', 'text', 'createdAt'])
        && request.resource.data.projectId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
